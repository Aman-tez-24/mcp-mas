# Application Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Server Ports and Host
HOST=127.0.0.1
PORT=8000

# MCP Server Configuration
# Transport options: "stdio" (recommended local default) or "sse"
MCP_TRANSPORT=stdio
MCP_SERVER_SCRIPT=mcp_server/server.py
MCP_SERVER_URL=http://127.0.0.1:8001/sse

# LLM Engine Strategy
# Options: "auto" (use Ollama if reachable, fallback to deterministic), "ollama", "deterministic"
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# Cost Accounting Assumptions (for comparative analysis in academic reports)
# Set to 0.0 for local self-hosted zero-cost runs.
INPUT_PRICE_PER_1M=0.0
OUTPUT_PRICE_PER_1M=0.0
